# PingPilot Backend Configuration
HOST=127.0.0.1
PORT=8000

# Ollama Local AI Configuration
# Point to your local Ollama daemon
OLLAMA_HOST=http://localhost:11434

# Configurable open-weight model name (e.g. llama3.2, mistral, qwen2.5, phi3)
OLLAMA_MODEL=llama3.2

# SQLite Local Database Storage
SQLITE_DB_PATH=backend/data/pingpilot.db
